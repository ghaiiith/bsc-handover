{
  "name": "eduwork",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:clean": "node scripts/dev-reset.mjs && next dev --webpack",
    "dev:reset": "node scripts/dev-reset.mjs",
    "build": "npm run typecheck && next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:claims:dry-run": "npx tsx scripts/backfill-auth-claims.ts --dry-run",
    "auth:claims:backfill": "npx tsx scripts/backfill-auth-claims.ts",
    "db:wipe:dry-run": "npx tsx scripts/wipe-all-data.ts --dry-run",
    "db:wipe": "npx tsx scripts/wipe-all-data.ts --confirm",
    "docs:roadmap:pdf": "node scripts/generate-roadmap-pdf.mjs",
    "verify": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/cairo": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "framer-motion": "^12.40.0",
    "hls.js": "^1.6.16",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "plyr": "^3.8.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "sanitize-html": "^2.17.5",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@neplex/vectorizer": "^0.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "md-to-pdf": "^5.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
